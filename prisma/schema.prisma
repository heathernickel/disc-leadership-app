generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum DiscStyle {
  D
  I
  S
  C
}

model AssessmentSubmission {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  completed      Boolean  @default(false)
  firstName      String?
  lastName       String?
  email          String?
  company        String?
  role           String?
  answersJson    Json
  dScore         Int
  iScore         Int
  sScore         Int
  cScore         Int
  primaryStyle   DiscStyle
  secondaryStyle DiscStyle
  blendLabel     String
  narrativeJson  Json
  answers        AssessmentAnswer[]

  @@index([createdAt])
  @@index([email])
  @@index([company])
  @@index([primaryStyle])
}

model AssessmentAnswer {
  id           String               @id @default(cuid())
  submissionId String
  submission   AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  value        Int

  @@index([submissionId])
  @@unique([submissionId, questionId])
}
